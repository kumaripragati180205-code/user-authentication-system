PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration: 'sqlite' or 'postgres'
DB_TYPE=sqlite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/authshield

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

